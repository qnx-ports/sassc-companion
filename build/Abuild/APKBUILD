d20496cca2960944c3e8251a5fc6ab1b291d76817d7c566fdeb656e2f58da9ffae2e984b91a3d9a885d2ad34f64071607704c95e85a5b700643cbfe094b52381  fix-sysexit-nonexists.patch
"
